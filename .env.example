# POSTGRES
POSTGRES_USER=admin
POSTGRES_PASSWORD=superpassword
POSTGRES_DB=rust_rest_api

# PGADMIN
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=turbopassword

# SERVER
SERVER_ENVIRONMENT="develop"
SERVER_HOST="0.0.0.0"
SERVER_PORT=8000
# postgres://postgres:postgres@localhost:5432/mydb
SERVER_DATABASE_URL="postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}"