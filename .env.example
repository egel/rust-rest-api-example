# NOTE: dotenvy does not expand ${...} — write the connection string in full.

# POSTGRES
POSTGRES_USER=admin
POSTGRES_PASSWORD=superpassword
POSTGRES_DB=rust_rest_api

# PGADMIN
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=turbopassword

# SERVER
SERVER_ENVIRONMENT="develop"
SERVER_HOST="0.0.0.0"
SERVER_PORT=8000
SERVER_LOG_LEVEL="info,rust_rest_api_example=trace"
SERVER_DATABASE_URL="postgres://admin:superpassword@localhost:5432/rust_rest_api"

# SQL: url used at compile time by the sqlx `query!` macros for query checking.
DATABASE_URL="postgres://admin:superpassword@localhost:5432/rust_rest_api"
